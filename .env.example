# Credentials for `npm run deploy`.
# Copy this file to .env and fill it in. .env is git-ignored and never
# included in the uploaded packages or source archives.
# Never prefix these with VITE_ or WXT_: those variables are bundled into the
# extensions.

# ── Chrome Web Store (API v2) ────────────────────────────────────────────
# Developer Dashboard → Publisher → Settings → Publisher ID
CHROME_PUBLISHER_ID=

# Option A (recommended, never expires): a Google Cloud service account.
#   1. In Google Cloud, enable the "Chrome Web Store API" and create a
#      service account, then download a JSON key for it.
#   2. In the Chrome Web Store Developer Dashboard → Account, add the
#      service account's email address.
# Path to the JSON key, absolute or relative to this repo. Keep it outside the
# repo or in secrets/ (git-ignored and excluded from source archives).
CHROME_SERVICE_ACCOUNT_KEY_FILE=

# Option B: OAuth client + refresh token with the scope
# https://www.googleapis.com/auth/chromewebstore. Refresh tokens of OAuth
# apps in "Testing" status expire after 7 days.
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# DEFAULT_PUBLISH: goes live as soon as it passes review.
# STAGED_PUBLISH: waits for you to press Publish in the dashboard.
CHROME_PUBLISH_TYPE=DEFAULT_PUBLISH

# ── Firefox Add-ons (AMO API v5) ─────────────────────────────────────────
# https://addons.mozilla.org/developers/addon/api/key/
FIREFOX_JWT_ISSUER=
FIREFOX_JWT_SECRET=
